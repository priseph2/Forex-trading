# ── Polygon.io ────────────────────────────────────────────────────────────────
# Free key at https://polygon.io
POLYGON_API_KEY=your_polygon_api_key_here

# ── OANDA (Forex broker) ───────────────────────────────────────────────────────
# Create a free practice account at https://www.oanda.com
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001
OANDA_API_KEY=your_oanda_practice_api_key
OANDA_PRACTICE=true   # set to false for live trading

# ── Binance (Crypto broker) ───────────────────────────────────────────────────
# Testnet keys at https://testnet.binance.vision
BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_SECRET_KEY=your_binance_testnet_secret_key
BINANCE_TESTNET=true  # set to false for live trading

# ── Telegram notifications ────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCDEF...
TELEGRAM_CHAT_ID=your_numeric_chat_id

# ── Bot risk settings ─────────────────────────────────────────────────────────
BOT_RISK_PCT=0.01        # 1% of account balance risked per trade
BOT_TARGET_PCT=0.01      # 1% take-profit target per trade
BOT_MAX_OPEN_TRADES=2    # Maximum concurrent open trades
BOT_DB_PATH=bot_state.db # SQLite database file path

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
